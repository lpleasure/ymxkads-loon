#!name=游民星空去广告
#!desc=移除游民星空 App 开屏广告、弹窗广告、信息流广告、头条轮播图、正在热销、文章页相关推荐及游戏购买卡片（纯重写，无脚本）
#!author=lpleasure
#!homepage=https://github.com/lpleasure/ymxkads-loon
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Game.png
#!date=2026-10-25

[Rewrite]
# 弹窗广告
^https?:\/\/router\d*\.gamersky\.com\/@\/adSystem\/ad\/getAppPopupAd reject-dict

# 广告统计上报
^https?:\/\/item-statistics\.gamersky\.com(:\d+)?\/ad\/statistics reject-dict
^https?:\/\/appapi2click\.gamersky\.com\/v\d\/(statisticAd|reportHomeBanner) reject-dict

# 开屏广告（自营）
^https?:\/\/router\d*\.gamersky\.com\/@\/adSystem\/ad\/getAdAtLaunchView response-body-json-jq 'if .data then .data.ad = null | .data.position.enable = 0 | .data.position.isValidRequest = 0 | .data.position.showSeconds = 0 else . end'

# 文章页推荐 / 底部广告开关
^https?:\/\/router\d*\.gamersky\.com\/@\/adSystem\/tempAdConfig\/get response-body-json-jq 'if .config then .config.postBottomAd.isEnable = false | .config.postBottomAd.iOSEnable = false | .config.postRecommendAd.isEnable = false | .config.postRecommendAd.iOSEnable = false | .config.pddAdConfig.isOpenStatistics = false else . end'

# 第三方开屏 / 信息流广告 SDK 配置
^https?:\/\/router\d*\.gamersky\.com\/@\/app\/config\/ response-body-json-jq 'if .config then .config += {"ioslaunchAdProviderName":"close","ioslaunchAdPercentageAdTroop":0,"ioslaunchAdPercentageUBIX":0,"ioslaunchAdPercentageWhalessp":0,"ioslaunchAdIdAdTroop":"","ioslaunchAdIdChuanShanJia":"","ioslaunchAdIdGuangDianTong":"","ioslaunchAdIdUBIX":"","ioslaunchAdIdWhalessp":"","ioslistAdIdAdTroop":"","ioslistAdIdChuanShanJia":"","ioslistAdIdUBIX":"","ioslistAdPercentageADTroop":0,"ioslistAdPercentageUBIX":0,"ioslistWangMengAdProviderName":"close","ioslistWangMengAdPositionNumbers":[],"ioslistZhiKeAdProviderName":"close","ioslistZhiKeAdPositionNumbers":[],"iosPostPageBottomAdProvider":"close","iosPostPageRelatedAdProvider":"close","preloadAdVideos":[]} else . end'

# 信息流 / 页面：广告条目、头条轮播图、「正在热销」商城模块、文章页「相关推荐」
^https?:\/\/router\d*\.gamersky\.com\/@\/(lists\/getListElements|pageUi\/) response-body-json-jq 'if (.listElements | type) == "array" then (if ((.listElements | length) > 0 and ([.listElements[] | select(has("itemStatisticsParam") or has("cmsArticleId") or ((.type == "sanTu" or .type == "santu" or .type == "xinWen" or .type == "xinwen" or .type == "daTu" or .type == "datu") | not))] | length) == 0) then .listElements = [] else .listElements = [.listElements[] | select(((.adCategory // "") == "") and ((.adType // "") == "") and (.beAdIconVisible != true) and (((.adId // "0") | tostring) == "0" or ((.adId // "0") | tostring) == "") and (.type != "huanDeng") and (.type != "game_topic_list") and ((.type == "biaoTiLan" and (((.title // "") == ([27491,22312,28909,38144] | implode)) or (((.contentUrl // "") | tostring | index("YouXiShangCheng")) != null))) | not)) | if (.childElements | type) == "array" then .childElements = [.childElements[] | select(((.adCategory // "") == "") and ((.adType // "") == "") and (.beAdIconVisible != true) and (((.adId // "0") | tostring) == "0" or ((.adId // "0") | tostring) == ""))] else . end] end) else . end'

# 文章页：底部游戏购买卡片
^https?:\/\/router\d*\.gamersky\.com\/@\/postPage\/index\/ response-body-json-jq 'if (.post | type) == "object" and (.post.widgetsName | type) == "array" then .post.widgetsName = [.post.widgetsName[] | select(. != ([28216,25103,21345,29255] | implode))] else . end'

# 文章页：相关推荐 / 底部广告位
^https?:\/\/router\d*\.gamersky\.com\/@\/adSystem\/ad\/getAdInPostPage response-body-json-jq '(if (.bottomAdInfo | type) == "object" then .bottomAdInfo.valid = false else . end) | (if (.relatedAdInfo | type) == "object" then .relatedAdInfo.valid = false else . end)'

[MITM]
hostname = router*.gamersky.com, appapi2click.gamersky.com, item-statistics.gamersky.com
